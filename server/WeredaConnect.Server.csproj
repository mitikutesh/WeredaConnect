<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
    <OutputType>Exe</OutputType>

    <!-- Lambda Configuration -->
    <AWSProjectType>Lambda</AWSProjectType>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Native AOT -->
    <PublishAot>true</PublishAot>

    <!-- Performance Optimizations -->
    <TieredCompilation>false</TieredCompilation>
    <TieredCompilationQuickJit>false</TieredCompilationQuickJit>
  </PropertyGroup>

  <!-- Native AOT Publish Configuration -->
  <PropertyGroup Condition="'$(IsPublishing)' == 'true' or '$(PublishDir)' != ''">
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Use linux-arm64 for AWS Lambda Graviton2 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- StripSymbols requires llvm-objcopy (Linux only) - enable in CI/CD -->
    <StripSymbols Condition="'$(CI)' == 'true'">true</StripSymbols>
    <StripSymbols Condition="'$(CI)' != 'true'">false</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- AWS Lambda -->
    <PackageReference Include="Amazon.Lambda.Core" Version="2.8.1" />
    <PackageReference Include="Amazon.Lambda.APIGatewayEvents" Version="3.0.1" />
    <PackageReference Include="Amazon.Lambda.RuntimeSupport" Version="1.14.3" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="2.4.5" />
    <PackageReference Include="Amazon.Lambda.DynamoDBEvents" Version="4.0.0" />

    <!-- AWS SDK (AOT-Compatible) -->
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.0.109.1" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.511.8" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="3.7.504.43" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="3.7.505.15" />
    <PackageReference Include="AWSSDK.SimpleNotificationService" Version="3.7.502.61" />

    <!-- Database Access (AOT-Compatible) -->
    <!-- ❌ BANNED: Entity Framework Core -->
    <!-- ✅ USE: Dapper -->
    <PackageReference Include="Dapper" Version="2.1.1" />

    <!-- JWT Validation (AOT-Compatible) -->
    <!-- ❌ BANNED: Microsoft.AspNetCore.Authentication.JwtBearer -->
    <!-- ✅ USE: System.IdentityModel.Tokens.Jwt -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.3.0" />

    <!-- AWS Cognito -->
    <PackageReference Include="AWSSDK.CognitoIdentityProvider" Version="3.7.505.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude test files from main project -->
    <Compile Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Make internal members visible to test project -->
    <InternalsVisibleTo Include="WeredaConnect.Server.Tests" />
  </ItemGroup>

</Project>
