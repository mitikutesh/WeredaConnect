---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import DownloadCTA from '../components/DownloadCTA.astro';
import { t, localePath } from '../i18n';
import en from '../i18n/en.json';

const locale = 'en';
const d = en.deleteAccount;
const email = t(locale, 'contact.info.email');
---

<Layout
  locale={locale}
  title={`${t(locale, 'deleteAccount.title')} | WeredaConnect`}
  description={t(locale, 'deleteAccount.subtitle')}
>
  <PageHeader title={t(locale, 'deleteAccount.title')} lead={t(locale, 'deleteAccount.subtitle')} compact narrow />

  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 space-y-12">
      <p class="text-slate leading-relaxed animate-on-scroll">{t(locale, 'deleteAccount.intro')}</p>

      <div class="animate-on-scroll">
        <h2 class="text-2xl font-bold mb-4 text-ink">{t(locale, 'deleteAccount.how.title')}</h2>
        <ol class="list-decimal list-inside space-y-2 text-slate leading-relaxed">
          {d.how.steps.map((s) => (<li>{s}</li>))}
        </ol>
        <p class="text-sm text-slate mt-4">{t(locale, 'deleteAccount.how.note')}</p>
      </div>

      <div class="animate-on-scroll bg-paper border border-line rounded-3xl p-6">
        <h2 class="text-xl font-bold mb-2">{t(locale, 'deleteAccount.noApp.title')}</h2>
        <p class="text-slate leading-relaxed">
          {t(locale, 'deleteAccount.noApp.text')}{' '}
          <a href={`mailto:${email}`} class="font-semibold text-ink underline underline-offset-2 hover:no-underline">{email}</a>
        </p>
      </div>

      <div class="animate-on-scroll">
        <h2 class="text-2xl font-bold mb-4 text-orange-ink">{t(locale, 'deleteAccount.deleted.title')}</h2>
        <p class="text-slate leading-relaxed mb-3">{t(locale, 'deleteAccount.deleted.intro')}</p>
        <ul class="list-disc list-inside space-y-1 text-slate">
          {d.deleted.items.map((s) => (<li>{s}</li>))}
        </ul>
      </div>

      <div class="animate-on-scroll">
        <h2 class="text-2xl font-bold mb-4 text-ink">{t(locale, 'deleteAccount.kept.title')}</h2>
        <p class="text-slate leading-relaxed">{t(locale, 'deleteAccount.kept.text')}</p>
      </div>

      <div class="animate-on-scroll">
        <h2 class="text-2xl font-bold mb-4 text-ink">{t(locale, 'deleteAccount.timeline.title')}</h2>
        <ul class="list-disc list-inside space-y-2 text-slate leading-relaxed">
          {d.timeline.items.map((s) => (<li>{s}</li>))}
        </ul>
      </div>

      <div class="animate-on-scroll">
        <h2 class="text-2xl font-bold mb-4 text-orange-ink">{t(locale, 'deleteAccount.blocked.title')}</h2>
        <p class="text-slate leading-relaxed">{t(locale, 'deleteAccount.blocked.text')}</p>
      </div>

      <div class="animate-on-scroll border-t border-line pt-8">
        <h2 class="text-xl font-bold mb-2">{t(locale, 'deleteAccount.questions.title')}</h2>
        <p class="text-slate leading-relaxed">
          {t(locale, 'deleteAccount.questions.text')}{' '}
          <a href={`mailto:${email}`} class="font-semibold text-ink underline underline-offset-2 hover:no-underline">{email}</a>
        </p>
        <p class="text-sm text-slate mt-3">
          <a href={localePath(locale, '/privacy/')} class="font-semibold text-ink underline underline-offset-2 hover:no-underline">{t(locale, 'footer.privacy')}</a>
        </p>
      </div>
    </div>
  </section>

  <DownloadCTA locale={locale} />
</Layout>
