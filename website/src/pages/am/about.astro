---
import Layout from '../../layouts/Layout.astro';
import DownloadCTA from '../../components/DownloadCTA.astro';
import { t } from '../../i18n';
import am from '../../i18n/am.json';

const locale = 'am';
---

<Layout locale={locale} title={`${t(locale, 'about.heading')} | ወረዳ ኮነክት`}>
  <section class="bg-gradient-to-br from-primary-dark to-primary text-white py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h1 class="text-3xl md:text-4xl font-bold mb-4 animate-on-scroll">{t(locale, 'about.heading')}</h1>
    </div>
  </section>

  <section class="py-16 bg-surface">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-16">
      <div class="animate-on-scroll">
        <h2 class="text-2xl font-bold mb-4 text-primary">{t(locale, 'about.mission.title')}</h2>
        <p class="text-text-muted leading-relaxed">{t(locale, 'about.mission.text')}</p>
      </div>
      <div class="animate-on-scroll">
        <h2 class="text-2xl font-bold mb-4 text-accent">{t(locale, 'about.problem.title')}</h2>
        <p class="text-text-muted leading-relaxed">{t(locale, 'about.problem.text')}</p>
      </div>
      <div class="animate-on-scroll">
        <h2 class="text-2xl font-bold mb-4 text-primary-light">{t(locale, 'about.solution.title')}</h2>
        <p class="text-text-muted leading-relaxed">{t(locale, 'about.solution.text')}</p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-cream">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl font-bold text-center mb-10 animate-on-scroll">{t(locale, 'about.values.title')}</h2>
      <div class="grid sm:grid-cols-2 gap-6 stagger-children">
        {am.about.values.items.map((item) => (
          <div class="animate-on-scroll bg-surface rounded-xl p-6 shadow-sm border border-border-light">
            <h3 class="font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-sm text-text-muted">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <DownloadCTA locale={locale} />
</Layout>
