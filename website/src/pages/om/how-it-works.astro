---
import Layout from '../../layouts/Layout.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import DownloadCTA from '../../components/DownloadCTA.astro';
import { t } from '../../i18n';

const locale = 'om';
---

<Layout locale={locale} title={`${t(locale, 'howItWorks.heading')} | WeredaConnect`}>
  <section class="bg-gradient-to-br from-primary-dark to-primary text-white py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h1 class="text-3xl md:text-4xl font-bold mb-4 animate-on-scroll">{t(locale, 'howItWorks.heading')}</h1>
      <p class="text-white/80 animate-on-scroll">{t(locale, 'howItWorks.subtitle')}</p>
    </div>
  </section>

  <HowItWorks locale={locale} full />
  <DownloadCTA locale={locale} />
</Layout>
