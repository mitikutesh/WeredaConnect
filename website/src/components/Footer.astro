---
import type { Locale } from '../i18n';
import { t, localePath, locales } from '../i18n';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
const currentPath = Astro.url.pathname;
const email = t(locale, 'contact.info.email');

const productLinks = [
  { key: 'nav.home', path: '/' },
  { key: 'nav.about', path: '/about/' },
  { key: 'nav.howItWorks', path: '/how-it-works/' },
  { key: 'nav.contact', path: '/contact/' },
];
const legalLinks = [
  { key: 'footer.privacy', path: '/privacy/' },
  { key: 'footer.deleteAccount', path: '/delete-account/' },
];
const linkClass = 'text-[15px] text-on-dark no-underline transition-colors hover:text-white';
const headingClass = 'eyebrow text-white';
---

<footer class="bg-primary-dark text-on-dark">
  <div class="mx-auto max-w-[1200px] px-6 pt-16 pb-6 flex flex-col gap-12">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-x-8 gap-y-10">
      <div class="flex flex-col gap-4">
        <Logo href={localePath(locale, '/')} label={t(locale, 'nav.homeLabel')} class="text-white" />
        <p class="m-0 max-w-[300px] text-[15px] leading-[1.6]">{t(locale, 'footer.tagline')}</p>
        <div class="flex flex-col gap-2 text-sm">
          <a href={`mailto:${email}`} class="inline-flex items-center gap-2 text-white no-underline hover:underline">
            <Icon name="mail" size={16} />
            <span>{email}</span>
          </a>
          <span class="inline-flex items-center gap-2">
            <Icon name="pin" size={16} />
            <span>{t(locale, 'contact.info.location')}</span>
          </span>
        </div>
      </div>

      <div class="flex flex-col gap-3.5">
        <h2 class={headingClass}>{t(locale, 'footer.links')}</h2>
        {productLinks.map((link) => (
          <a href={localePath(locale, link.path)} class={linkClass}>{t(locale, link.key)}</a>
        ))}
      </div>

      <div class="flex flex-col gap-3.5">
        <h2 class={headingClass}>{t(locale, 'footer.legal')}</h2>
        {legalLinks.map((link) => (
          <a href={localePath(locale, link.path)} class={linkClass}>{t(locale, link.key)}</a>
        ))}
      </div>

      <div class="flex flex-col gap-3.5">
        <h2 class={headingClass}>{t(locale, 'footer.language')}</h2>
        <div role="group" aria-label={t(locale, 'nav.languageLabel')} class="flex flex-wrap gap-2">
          {locales.map((loc) => (
            <a
              href={localePath(loc.code, currentPath.replace(/^\/(am|om)/, '') || '/')}
              lang={loc.code}
              hreflang={loc.code}
              aria-current={locale === loc.code ? 'true' : undefined}
              class:list={[
                'inline-flex items-center min-h-[36px] px-3.5 py-2 rounded-full text-[13px] font-bold no-underline',
                loc.code === 'am' && 'font-ethiopic',
                locale === loc.code ? 'bg-white text-primary-dark' : 'border border-white/30 text-white hover:border-white',
              ]}
            >
              {loc.name}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="flex flex-wrap justify-between gap-x-6 gap-y-3 border-t border-white/15 pt-6 text-[13px]">
      <span>&copy; {year} {t(locale, 'footer.copyright')}</span>
      <span>{t(locale, 'footer.builtFor')}</span>
    </div>
  </div>
</footer>
