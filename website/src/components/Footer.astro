---
import type { Locale } from '../i18n';
import { t, localePath, locales } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-text-dark text-white/80 pt-12 pb-6">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <!-- Brand -->
      <div>
        <a href={localePath(locale, '/')} class="text-xl font-bold text-white flex items-center gap-2 mb-3">
          <svg class="w-7 h-7" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
            <rect width="32" height="32" rx="6" fill="#1A6B5C"/>
            <text x="16" y="22" text-anchor="middle" font-family="system-ui" font-weight="700" font-size="18" fill="white">W</text>
          </svg>
          WeredaConnect
        </a>
        <p class="text-sm text-white/60 leading-relaxed">
          {t(locale, 'footer.tagline')}
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold text-white mb-3">{t(locale, 'footer.links')}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={localePath(locale, '/about/')} class="hover:text-white transition-colors">{t(locale, 'nav.about')}</a></li>
          <li><a href={localePath(locale, '/how-it-works/')} class="hover:text-white transition-colors">{t(locale, 'nav.howItWorks')}</a></li>
          <li><a href={localePath(locale, '/contact/')} class="hover:text-white transition-colors">{t(locale, 'nav.contact')}</a></li>
        </ul>
      </div>

      <!-- Language -->
      <div>
        <h3 class="text-sm font-semibold text-white mb-3">{t(locale, 'footer.legal')}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="#" class="hover:text-white transition-colors">{t(locale, 'footer.privacy')}</a></li>
          <li><a href="#" class="hover:text-white transition-colors">{t(locale, 'footer.terms')}</a></li>
        </ul>
        <div class="mt-4 flex gap-2">
          {locales.map((loc) => (
            <a
              href={localePath(loc.code, '/')}
              class:list={[
                'px-2 py-1 text-xs rounded',
                locale === loc.code ? 'bg-white/20 text-white' : 'text-white/50 hover:text-white',
              ]}
            >
              {loc.label}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 pt-6 text-center text-xs text-white/40">
      &copy; {year} {t(locale, 'footer.copyright')}
    </div>
  </div>
</footer>
