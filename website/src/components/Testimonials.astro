---
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const testimonials = [
  { key: 'farmer', color: 'bg-primary/10', accent: 'text-primary' },
  { key: 'trucker', color: 'bg-accent/10', accent: 'text-accent' },
  { key: 'buyer', color: 'bg-primary-light/10', accent: 'text-primary-light' },
];
---

<section class="py-16 md:py-24 bg-cream">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <h2 class="text-2xl md:text-3xl font-bold text-center mb-12 animate-on-scroll">
      {t(locale, 'testimonials.heading')}
    </h2>
    <div class="grid md:grid-cols-3 gap-8 stagger-children">
      {testimonials.map((item) => (
        <div class="animate-on-scroll bg-surface rounded-xl p-6 shadow-sm border border-border-light">
          <div class={`w-10 h-10 ${item.color} rounded-full flex items-center justify-center mb-4`}>
            <svg class={`w-5 h-5 ${item.accent}`} fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
            </svg>
          </div>
          <blockquote class="text-text-dark mb-4 italic leading-relaxed">
            "{t(locale, `testimonials.${item.key}.quote`)}"
          </blockquote>
          <div>
            <div class="font-semibold text-sm">{t(locale, `testimonials.${item.key}.name`)}</div>
            <div class="text-xs text-text-muted">{t(locale, `testimonials.${item.key}.role`)}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
