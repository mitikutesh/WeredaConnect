---
import type { Locale } from '../../i18n';
import { t, localePath } from '../../i18n';
import Icon from '../Icon.astro';
import PageHeader from '../PageHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const email = t(locale, 'contact.info.email');
const field =
  'box-border w-full min-h-[52px] rounded-xl border-[1.5px] border-border-input bg-white px-4 py-3.5 text-base text-text-dark placeholder:text-[#757575] focus:border-primary';
const label = 'text-sm font-bold';
const cardLabel = 'text-[13px] font-bold uppercase tracking-[0.1em]';
---

<PageHeader
  eyebrow={t(locale, 'contact.eyebrow')}
  title={t(locale, 'contact.heading')}
  lead={t(locale, 'contact.subtitle')}
  compact
/>

<section aria-label={t(locale, 'contact.heading')} class="px-6 pb-24">
  <div class="mx-auto max-w-[1200px] flex flex-wrap items-start gap-6">
    <div class="box-border min-w-0 flex-[2_1_480px] rounded-3xl border border-border-light bg-white p-[clamp(24px,4vw,40px)] animate-on-scroll">
      {/* Plain POST without JavaScript; with it, the script below posts in the background and swaps in the thank-you panel. */}
      <form
        action="https://formspree.io/f/xpznqkdl"
        method="POST"
        class="flex flex-col gap-5"
        data-contact-form
        data-sending={t(locale, 'contact.sending')}
      >
        <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-5">
          <div class="flex flex-col gap-2">
            <label for="contact-name" class={label}>{t(locale, 'contact.name')}</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required placeholder={t(locale, 'contact.namePlaceholder')} class={field} />
          </div>
          <div class="flex flex-col gap-2">
            <label for="contact-email" class={label}>{t(locale, 'contact.email')}</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required placeholder={t(locale, 'contact.emailPlaceholder')} class={field} />
          </div>
        </div>
        <div class="flex flex-col gap-2">
          <label for="contact-message" class={label}>{t(locale, 'contact.message')}</label>
          <textarea id="contact-message" name="message" rows="6" required placeholder={t(locale, 'contact.messagePlaceholder')} class:list={[field, 'resize-y leading-[1.5]']}></textarea>
        </div>
        <p role="alert" class="m-0 text-sm font-semibold text-accent-dark" data-contact-error hidden>
          {t(locale, 'contact.error')} <a href={`mailto:${email}`} class="text-accent-dark underline">{email}</a>
        </p>
        <div class="flex flex-wrap items-center justify-between gap-4">
          <span class="text-[13px] text-text-muted">{t(locale, 'contact.note')}</span>
          <button type="submit" class="btn cursor-pointer border-0 bg-accent font-[inherit] text-white hover:bg-accent-dark disabled:cursor-wait disabled:opacity-70">
            <span data-contact-label>{t(locale, 'contact.send')}</span>
            <Icon name="arrowRight" size={20} />
          </button>
        </div>
      </form>

      <div role="status" class="flex flex-col items-start gap-4 py-6" data-contact-success hidden>
        <span class="flex h-14 w-14 items-center justify-center rounded-[18px] bg-primary-tint text-primary">
          <Icon name="check" size={28} strokeWidth={2.2} />
        </span>
        <h2 class="m-0 text-[28px] font-extrabold tracking-[-0.02em]" tabindex="-1">{t(locale, 'contact.successTitle')}</h2>
        <p class="m-0 max-w-[480px] text-base leading-[1.6] text-text-muted">{t(locale, 'contact.successText')}</p>
        <a href={localePath(locale, '/how-it-works/')} class="inline-flex min-h-[44px] items-center gap-2 text-base font-bold text-primary no-underline hover:underline">
          <span>{t(locale, 'nav.howItWorks')}</span>
          <Icon name="arrowRight" size={20} />
        </a>
      </div>
    </div>

    <div class="flex min-w-0 flex-[1_1_300px] flex-col gap-4 animate-on-scroll">
      <div class="flex flex-col gap-5 rounded-3xl bg-primary p-8 text-white">
        <span class="flex h-11 w-11 items-center justify-center rounded-[14px] bg-white/15">
          <Icon name="mail" size={22} />
        </span>
        <div class="flex flex-col gap-1.5">
          <span class:list={[cardLabel, 'text-on-dark']}>{t(locale, 'contact.info.emailLabel')}</span>
          <a href={`mailto:${email}`} class="break-words text-xl font-bold text-white no-underline hover:underline">{email}</a>
        </div>
      </div>
      <div class="flex flex-col gap-5 rounded-3xl border border-border-light bg-white p-8">
        <span class="flex h-11 w-11 items-center justify-center rounded-[14px] bg-primary-tint text-primary">
          <Icon name="pin" size={22} />
        </span>
        <div class="flex flex-col gap-1.5">
          <span class:list={[cardLabel, 'text-text-muted']}>{t(locale, 'contact.info.locationLabel')}</span>
          <span class="text-xl font-bold">{t(locale, 'contact.info.location')}</span>
        </div>
      </div>
      <div class="flex flex-col gap-3 rounded-3xl bg-accent-tint p-8">
        <span class:list={[cardLabel, 'text-accent-dark']}>{t(locale, 'contact.partnerships.title')}</span>
        <p class="m-0 text-[15px] leading-[1.6] text-text-dark">{t(locale, 'contact.partnerships.text')}</p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const success = document.querySelector<HTMLElement>('[data-contact-success]');
  const error = form?.querySelector<HTMLElement>('[data-contact-error]');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const label = form?.querySelector<HTMLElement>('[data-contact-label]');
  const sendText = label?.textContent ?? '';

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!button || !label || !error || !success) return;
    button.disabled = true;
    label.textContent = form.dataset.sending ?? sendText;
    error.hidden = true;
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(`Form endpoint returned ${response.status}`);
      form.hidden = true;
      success.hidden = false;
      success.querySelector<HTMLElement>('h2')?.focus();
    } catch (err) {
      console.error('Contact form submit failed', err);
      error.hidden = false;
      button.disabled = false;
      label.textContent = sendText;
    }
  });
</script>
