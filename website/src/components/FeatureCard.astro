---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  title: string;
  description: string;
  icon: IconName;
  /** Card fill: cream on white sections, white on cream sections. */
  tone?: 'cream' | 'white';
}

const { title, description, icon, tone = 'cream' } = Astro.props;
---

<article
  class:list={[
    'flex flex-col gap-4 rounded-[20px] border border-border-light p-7 animate-on-scroll',
    tone === 'cream' ? 'bg-cream' : 'bg-white',
  ]}
>
  <span class="flex h-12 w-12 items-center justify-center rounded-[14px] bg-primary-tint text-primary">
    <Icon name={icon} strokeWidth={1.8} />
  </span>
  <h3 class="m-0 text-xl font-bold tracking-[-0.01em]">{title}</h3>
  <p class="m-0 text-[15px] leading-[1.6] text-text-muted">{description}</p>
</article>
