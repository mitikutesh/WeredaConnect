---
import type { Locale } from '../i18n';
import { t, localePath } from '../i18n';
import Icon from './Icon.astro';
import HeroPhone from './HeroPhone.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const points = ['hero.point1', 'hero.point2', 'hero.point3'];
---

<section aria-labelledby="hero-title" class="px-6 py-[72px]">
  <div class="mx-auto max-w-[1200px] flex flex-wrap items-center gap-x-16 gap-y-12">
    <div class="flex min-w-0 flex-[1_1_440px] flex-col gap-6 animate-on-scroll">
      <p class="eyebrow text-accent-dark">{t(locale, 'hero.eyebrow')}</p>
      <h1 id="hero-title" class="m-0 text-[clamp(40px,4.6vw,66px)] leading-[1.04] tracking-[-0.025em] font-extrabold">
        {t(locale, 'hero.title')}
      </h1>
      <p class="m-0 max-w-[540px] text-xl leading-[1.55] text-text-muted">{t(locale, 'hero.subtitle')}</p>
      <div class="flex flex-wrap items-center gap-3">
        <a href={localePath(locale, '/#download')} class="btn bg-accent text-white hover:bg-accent-dark">
          <Icon name="download" size={20} />
          <span>{t(locale, 'hero.cta')}</span>
        </a>
        <a href={localePath(locale, '/how-it-works/')} class="btn border-[1.5px] border-primary text-primary hover:bg-primary-tint">
          <span>{t(locale, 'hero.seeHow')}</span>
          <Icon name="arrowRight" size={20} />
        </a>
      </div>
      <ul class="mt-2 flex list-none flex-wrap gap-x-6 gap-y-3 p-0 text-sm font-semibold text-text-muted">
        {points.map((key) => (
          <li class="inline-flex items-center gap-2">
            <Icon name="check" size={18} strokeWidth={2.2} class="text-primary" />
            <span>{t(locale, key)}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex min-w-0 flex-[1_1_400px] justify-center animate-on-scroll fade">
      <HeroPhone locale={locale} />
    </div>
  </div>
</section>
