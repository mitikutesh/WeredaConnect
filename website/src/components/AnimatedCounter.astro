---
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const stats = [
  { key: 'stats.farmers', value: '5,000+', icon: '🌾' },
  { key: 'stats.trips', value: '12,000+', icon: '🚛' },
  { key: 'stats.regions', value: '8', icon: '📍' },
  { key: 'stats.saved', value: '2M+ ETB', icon: '💰' },
];
---

<section class="py-16 bg-primary-dark text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <h2 class="text-2xl md:text-3xl font-bold text-center mb-12 animate-on-scroll">
      {t(locale, 'stats.heading')}
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 stagger-children">
      {stats.map((stat) => (
        <div class="animate-on-scroll text-center">
          <div class="text-3xl mb-2">{stat.icon}</div>
          <div class="text-3xl md:text-4xl font-bold mb-1" data-counter>{stat.value}</div>
          <div class="text-sm text-white/70">{t(locale, stat.key)}</div>
        </div>
      ))}
    </div>
  </div>
</section>
