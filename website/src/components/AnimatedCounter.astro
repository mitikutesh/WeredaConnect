---
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const stats = [
  { key: 'stats.farmers', value: '5,000+' },
  { key: 'stats.trips', value: '12,000+' },
  { key: 'stats.regions', value: '8' },
  { key: 'stats.saved', value: '2M+ ETB' },
];
---

<section aria-labelledby="stats-title" class="bg-primary-dark px-6 py-14 text-white">
  <div class="mx-auto max-w-[1200px] flex flex-col gap-8">
    <h2 id="stats-title" class="eyebrow text-on-dark">{t(locale, 'stats.heading')}</h2>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-8 stagger-children">
      {stats.map((stat) => (
        <div class="flex flex-col gap-1.5 border-l-2 border-white/25 pl-5 animate-on-scroll">
          <span class="text-[44px] font-extrabold leading-none tracking-[-0.03em]">{stat.value}</span>
          <span class="text-[15px] text-on-dark">{t(locale, stat.key)}</span>
        </div>
      ))}
    </div>
  </div>
</section>
