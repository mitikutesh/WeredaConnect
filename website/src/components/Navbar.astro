---
import type { Locale } from '../i18n';
import { t, locales, localePath } from '../i18n';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { key: 'nav.home', path: '/' },
  { key: 'nav.about', path: '/about/' },
  { key: 'nav.howItWorks', path: '/how-it-works/' },
  { key: 'nav.contact', path: '/contact/' },
];
// Not sticky and no hamburger: on a phone the bar wraps to three rows, as
// drawn on the redesign canvas.
---

<header class="bg-surface border-b border-border-light">
  <div class="mx-auto max-w-[1200px] min-h-[72px] px-6 py-3 flex flex-wrap items-center gap-x-8 gap-y-3 md:justify-end">
    <Logo href={localePath(locale, '/')} label={t(locale, 'nav.homeLabel')} class="mr-auto text-primary" />

    <nav aria-label={t(locale, 'nav.mainLabel')} class="flex flex-wrap items-center gap-x-2 gap-y-1">
      {navLinks.map((link) => {
        const href = localePath(locale, link.path);
        const isActive = currentPath === href || (link.path !== '/' && currentPath.startsWith(href));
        return (
          <a
            href={href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'px-3 py-2 rounded-lg text-[15px] font-semibold no-underline transition-colors hover:text-text-dark',
              isActive ? 'text-text-dark shadow-[inset_0_-2px_0_var(--color-accent)]' : 'text-text-muted',
            ]}
          >
            {t(locale, link.key)}
          </a>
        );
      })}
    </nav>

    <div class="flex flex-wrap items-center gap-3">
      <div role="group" aria-label={t(locale, 'nav.languageLabel')} class="flex items-center gap-0.5 p-[3px] rounded-full border border-border-light bg-cream">
        {locales.map((loc) => {
          const href = localePath(loc.code, currentPath.replace(/^\/(am|om)/, '') || '/');
          return (
            <a
              href={href}
              lang={loc.code}
              hreflang={loc.code}
              aria-current={locale === loc.code ? 'true' : undefined}
              class:list={[
                'inline-flex items-center min-h-[30px] px-3 py-1.5 rounded-full text-[13px] font-bold no-underline transition-colors',
                loc.code === 'am' && 'font-ethiopic',
                locale === loc.code ? 'bg-primary text-white' : 'text-text-muted hover:text-text-dark',
              ]}
            >
              {loc.label}
            </a>
          );
        })}
      </div>
      <a
        href={localePath(locale, '/#download')}
        class="inline-flex items-center gap-2 min-h-[44px] px-[18px] py-[11px] rounded-[10px] bg-accent text-white text-[15px] font-bold no-underline transition-colors hover:bg-accent-dark"
      >
        <Icon name="download" size={18} />
        <span>{t(locale, 'nav.download')}</span>
      </a>
    </div>
  </div>
</header>
