---
import type { Locale } from '../i18n';
import { t, locales, localePath } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { key: 'nav.home', path: '/' },
  { key: 'nav.about', path: '/about/' },
  { key: 'nav.howItWorks', path: '/how-it-works/' },
  { key: 'nav.contact', path: '/contact/' },
];
---

<header class="sticky top-0 z-50 bg-surface/95 backdrop-blur-sm border-b border-border-light">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href={localePath(locale, '/')} class="flex items-center gap-2 font-bold text-lg text-primary">
      <svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
        <path d="M19.5,12c0.93,0,1.78,0.28,2.5,0.76V8c0-1.1-0.9-2-2-2h-6.29l-1.06-1.06l1.41-1.41l-0.71-0.71L9.82,6.35l0.71,0.71l1.41-1.41L13,6.71V9c0,1.1-0.9,2-2,2h-0.54c0.95,1.06,1.54,2.46,1.54,4c0,0.34-0.04,0.67-0.09,1h3.14C15.3,13.75,17.19,12,19.5,12z"/>
        <path d="M19.5,13c-1.93,0-3.5,1.57-3.5,3.5s1.57,3.5,3.5,3.5s3.5-1.57,3.5-3.5S21.43,13,19.5,13z M19.5,18c-0.83,0-1.5-0.67-1.5-1.5s0.67-1.5,1.5-1.5s1.5,0.67,1.5,1.5S20.33,18,19.5,18z"/>
        <path d="M4,9h5c0-1.1-0.9-2-2-2H4C3.45,7,3,7.45,3,8C3,8.55,3.45,9,4,9z"/>
        <path d="M9.83,13.82l-0.18-0.47L10.58,13c-0.46-1.06-1.28-1.91-2.31-2.43l-0.4,0.89l-0.46-0.21l0.4-0.9C7.26,10.13,6.64,10,6,10c-0.53,0-1.04,0.11-1.52,0.26l0.34,0.91l-0.47,0.18L4,10.42c-1.06,0.46-1.91,1.28-2.43,2.31l0.89,0.4l-0.21,0.46l-0.9-0.4C1.13,13.74,1,14.36,1,15c0,0.53,0.11,1.04,0.26,1.52l0.91-0.34l0.18,0.47L1.42,17c0.46,1.06,1.28,1.91,2.31,2.43l0.4-0.89l0.46,0.21l-0.4,0.9C4.74,19.87,5.36,20,6,20c0.53,0,1.04-0.11,1.52-0.26l-0.34-0.91l0.47-0.18L8,19.58c1.06-0.46,1.91-1.28,2.43-2.31l-0.89-0.4l0.21-0.46l0.9,0.4C10.87,16.26,11,15.64,11,15c0-0.53-0.11-1.04-0.26-1.52L9.83,13.82z M7.15,17.77c-1.53,0.63-3.29-0.09-3.92-1.62c-0.63-1.53,0.09-3.29,1.62-3.92c1.53-0.63,3.29,0.09,3.92,1.62C9.41,15.38,8.68,17.14,7.15,17.77z"/>
      </svg>
      <span>WeredaConnect</span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-6">
      {navLinks.map((link) => {
        const href = localePath(locale, link.path);
        const isActive = currentPath === href || (link.path !== '/' && currentPath.startsWith(href));
        return (
          <a
            href={href}
            class:list={[
              'text-sm font-medium transition-colors hover:text-primary',
              isActive ? 'text-primary' : 'text-text-muted',
            ]}
          >
            {t(locale, link.key)}
          </a>
        );
      })}

      <!-- Language Switcher -->
      <div class="flex items-center gap-1 ml-2 border-l border-border-light pl-4">
        {locales.map((loc) => {
          const href = localePath(loc.code, currentPath.replace(/^\/(am|om)/, '') || '/');
          return (
            <a
              href={href}
              class:list={[
                'px-2 py-1 text-xs font-semibold rounded transition-colors',
                locale === loc.code
                  ? 'bg-primary text-white'
                  : 'text-text-muted hover:bg-cream',
              ]}
            >
              {loc.label}
            </a>
          );
        })}
      </div>

      <a
        href={localePath(locale, '/#download')}
        class="ml-2 px-4 py-2 text-sm font-semibold bg-accent text-white rounded-lg hover:bg-accent-light transition-colors"
      >
        {t(locale, 'nav.download')}
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-text-muted hover:text-primary"
      aria-label="Toggle menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="menu-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        <path id="menu-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-border-light bg-surface">
    <div class="px-4 py-4 space-y-3">
      {navLinks.map((link) => {
        const href = localePath(locale, link.path);
        return (
          <a href={href} class="block text-sm font-medium text-text-dark hover:text-primary">
            {t(locale, link.key)}
          </a>
        );
      })}
      <div class="flex gap-2 pt-2 border-t border-border-light">
        {locales.map((loc) => {
          const href = localePath(loc.code, currentPath.replace(/^\/(am|om)/, '') || '/');
          return (
            <a
              href={href}
              class:list={[
                'px-3 py-1.5 text-xs font-semibold rounded',
                locale === loc.code
                  ? 'bg-primary text-white'
                  : 'bg-cream text-text-muted',
              ]}
            >
              {loc.label}
            </a>
          );
        })}
      </div>
      <a
        href={localePath(locale, '/#download')}
        class="block text-center px-4 py-2 text-sm font-semibold bg-accent text-white rounded-lg"
      >
        {t(locale, 'nav.download')}
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open');
  const closeIcon = document.getElementById('menu-close');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>
