---
// Illustration of the farmer offers screen in the app's page M look (white
// ground, black nav pill, orange action, the farmer's plum on links, amounts
// and tint pills). role="img" keeps screen readers on the one-line label
// instead of reading every mock string.
import type { Locale } from '../i18n';
import { t, initials } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = (key: string) => t(locale, `hero.mockup.${key}`);

const chips = ['chipAll', 'chipCoffee', 'chipTeff', 'chipOnion'];
const tabs = [
  { key: 'tabMarket', icon: 'sprout' },
  { key: 'tabTrips', icon: 'truck' },
  { key: 'tabWallet', icon: 'wallet' },
  { key: 'tabProfile', icon: 'user' },
] as const;
const card = 'flex flex-col gap-2 rounded-[20px] border border-line bg-paper p-3';
const price = 'text-[16px] font-extrabold text-farmer';
const unit = 'text-[11px] font-semibold text-slate';
const floating = 'absolute flex items-center gap-2.5 rounded-[20px] border border-line bg-white px-3.5 py-3 leading-[normal] shadow-[0_14px_30px_rgba(26,21,22,0.14)]';
---

<div role="img" aria-label={m('label')} class="relative w-full max-w-[540px] min-h-[600px] overflow-hidden rounded-[32px] bg-sand px-6 pt-12 flex justify-center">
  <div class="h-[640px] w-[300px] shrink-0 rounded-[44px] bg-ink p-2.5 shadow-[0_30px_60px_rgba(26,21,22,0.25)]">
    <div class="relative flex h-full w-full flex-col overflow-hidden rounded-[34px] bg-white text-[13px] leading-[normal] text-ink">
      <div class="flex items-center justify-between gap-3 px-[18px] pt-[22px] pb-3">
        <div class="flex flex-col gap-0.5">
          <span class="text-[12px] font-medium text-slate">{m('greeting')}</span>
          <span class="text-[20px] font-extrabold tracking-[-0.03em]">{m('name')}</span>
        </div>
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-farmer-tint text-[13px] font-extrabold text-farmer">{initials(m('name'))}</span>
      </div>
      <div class="mx-3.5 mb-2.5 flex items-center gap-2 rounded-full bg-orange-tint px-3 py-2 text-[12px] font-bold text-orange-ink">
        <Icon name="wifiOff" size={16} />
        <span>{m('offline')}</span>
      </div>
      <div class="mx-3.5 mb-3 flex items-center gap-2 rounded-full bg-paper px-3.5 py-2.5 text-slate">
        <Icon name="search" size={16} />
        <span class="min-w-0 flex-auto truncate">{m('search')}</span>
        <Icon name="mic" size={16} class="text-ink" />
      </div>
      <div class="flex gap-1.5 overflow-hidden px-3.5 pb-3">
        {chips.map((chip, i) => (
          <span
            class:list={[
              'whitespace-nowrap rounded-full px-3 py-1.5 text-[12px]',
              i === 0 ? 'bg-ink font-bold text-white' : 'border border-edge bg-white font-semibold text-ink-soft',
            ]}
          >
            {m(chip)}
          </span>
        ))}
      </div>
      <div class="flex items-baseline justify-between px-3.5 pb-1.5">
        <span class="text-[13px] font-extrabold">{m('offersTitle')}</span>
        <span class="text-[12px] font-bold text-farmer">{m('seeAll')}</span>
      </div>
      <div class="flex flex-auto flex-col gap-2 overflow-hidden px-3.5">
        <div class={card}>
          <div class="flex justify-between gap-2">
            <span class="text-[14px] font-extrabold">{m('buyer1')} · {m('city1')}</span>
            <span class="rounded-full bg-farmer-tint px-2 py-0.5 text-[11px] font-extrabold text-farmer">{m('verified')}</span>
          </div>
          <span class="text-[12px] text-slate">{m('offer1')}</span>
          <div class="flex items-center justify-between">
            <span class={price}>{m('price1')} <span class={unit}>{m('perQuintal')}</span></span>
            <span class="rounded-full bg-orange px-3.5 py-2 text-[12px] font-extrabold text-ink">{m('accept')}</span>
          </div>
        </div>
        <div class={card}>
          <div class="flex justify-between gap-2">
            <span class="text-[14px] font-extrabold">{m('buyer2')} · {m('city2')}</span>
            <span class="text-[11px] font-bold text-slate">{m('time2')}</span>
          </div>
          <span class="text-[12px] text-slate">{m('offer2')}</span>
          <div class="flex items-center justify-between">
            <span class={price}>{m('price2')} <span class={unit}>{m('perQuintal')}</span></span>
            <span class="rounded-full border-[1.5px] border-edge bg-white px-3.5 py-[7px] text-[12px] font-extrabold text-ink">{m('view')}</span>
          </div>
        </div>
        <div class={card}>
          <div class="flex justify-between gap-2">
            <span class="text-[14px] font-extrabold">{m('buyer3')} · {m('city3')}</span>
            <span class="text-[11px] font-bold text-slate">{m('time3')}</span>
          </div>
          <span class="text-[12px] text-slate">{m('offer3')}</span>
        </div>
      </div>
      <div class="absolute inset-x-3 bottom-3 grid grid-cols-4 rounded-full bg-ink px-2 py-2 text-center text-[10px] text-white shadow-[0_10px_24px_rgba(26,21,22,0.25)]">
        {tabs.map((tab, i) => (
          <span class:list={['relative flex flex-col items-center gap-0.5 pb-1.5', i === 0 ? 'font-bold' : 'font-medium']}>
            <Icon name={tab.icon} size={18} />
            <span>{m(tab.key)}</span>
            {i === 0 && <span class="absolute bottom-0 left-1/2 -ml-0.5 h-1 w-1 rounded-full bg-farmer-tint"></span>}
          </span>
        ))}
      </div>
    </div>
  </div>

  <div class:list={[floating, 'left-4 top-[130px] max-w-[218px]']}>
    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-farmer-tint text-farmer">
      <Icon name="sync" size={18} />
    </span>
    <span class="flex flex-col gap-0.5">
      <span class="text-[13px] font-extrabold text-ink">{m('syncedTitle')}</span>
      <span class="text-[12px] text-slate">{m('syncedText')}</span>
    </span>
  </div>

  <div class:list={[floating, 'right-4 top-[400px] max-w-[228px]']}>
    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-orange-tint text-orange-ink">
      <Icon name="shieldCheck" size={18} />
    </span>
    <span class="flex flex-col gap-0.5">
      <span class="text-[13px] font-extrabold text-ink">{m('escrowTitle')}</span>
      <span class="text-[12px] text-slate">{m('escrowText')}</span>
    </span>
  </div>
</div>
