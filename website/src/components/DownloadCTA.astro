---
import type { Locale } from '../i18n';
import { t, localePath } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  /** Home page variant: "Get the app" label above and the language line below. */
  full?: boolean;
  /** Drop the top padding when the section above already ends with it. */
  flush?: boolean;
}

const { locale, full = false, flush = false } = Astro.props;
---

<section id="download" aria-labelledby="cta-title" class:list={['px-6 pb-24', flush ? 'pt-0' : 'pt-24']}>
  <div class="mx-auto max-w-[1248px] flex flex-col items-center gap-6 rounded-[32px] bg-primary px-6 py-[clamp(48px,6vw,80px)] text-center text-white animate-on-scroll">
    {full && <p class="eyebrow text-on-dark">{t(locale, 'downloadCta.eyebrow')}</p>}
    <h2 id="cta-title" class="m-0 max-w-[760px] text-[clamp(32px,3.8vw,52px)] leading-[1.05] tracking-[-0.025em] font-extrabold">
      {t(locale, 'downloadCta.heading')}
    </h2>
    <p class="m-0 max-w-[560px] text-lg leading-[1.6] text-on-dark">{t(locale, 'downloadCta.subtitle')}</p>
    <div class="mt-2 flex flex-wrap justify-center gap-3">
      {/* Not a link yet: the Play Store listing is not live. */}
      <span class="btn gap-3 bg-white text-text-dark">
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M6 3l14 9-14 9z"/></svg>
        <span class="flex flex-col items-start leading-[1.15]">
          <span class="text-[11px] font-semibold uppercase tracking-[0.04em] text-text-muted">{t(locale, 'downloadCta.comingSoon')}</span>
          <span>Google Play</span>
        </span>
      </span>
      <a href={localePath(locale, '/contact/')} class="btn border-[1.5px] border-white/60 text-white hover:border-white hover:bg-white/10">
        <span>{t(locale, 'downloadCta.talk')}</span>
        <Icon name="arrowRight" size={20} />
      </a>
    </div>
    {full && <p class="mt-2 mb-0 text-sm text-on-dark">{t(locale, 'downloadCta.languages')}</p>}
  </div>
</section>
