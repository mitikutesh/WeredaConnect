---
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section id="download" class="py-16 md:py-24 bg-gradient-to-r from-primary to-primary-light text-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="text-2xl md:text-3xl font-bold mb-4 animate-on-scroll">
      {t(locale, 'downloadCta.heading')}
    </h2>
    <p class="text-white/80 mb-8 max-w-xl mx-auto animate-on-scroll">
      {t(locale, 'downloadCta.subtitle')}
    </p>
    <div class="animate-on-scroll">
      <a
        href="#"
        class="inline-flex items-center gap-3 px-6 py-3 bg-text-dark hover:bg-text-dark/90 text-white rounded-lg transition-colors"
      >
        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
          <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 010 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.8 8.99l-2.3 2.3-8.636-8.632z"/>
        </svg>
        <div class="text-left">
          <div class="text-xs text-white/70">{t(locale, 'downloadCta.comingSoon')}</div>
          <div class="text-sm font-semibold">Google Play</div>
        </div>
      </a>
    </div>
  </div>
</section>
