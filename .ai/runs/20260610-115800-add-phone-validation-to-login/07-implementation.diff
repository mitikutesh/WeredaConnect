diff --git a/Users/mitiku.geleta/Documents/Personal /WeredaConnect/.github/workflows/ai-plan-validation.yml b/Users/mitiku.geleta/Documents/Personal /WeredaConnect/.github/workflows/ai-plan-validation.yml
