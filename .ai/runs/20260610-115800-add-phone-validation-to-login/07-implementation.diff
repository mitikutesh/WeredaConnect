+
+# ---------------------------------------------------------------------------
+# Live status renderer (runs inside the "Live Status" pane).
+# Set AI_DASH_ONCE=1 to render a single frame and exit (for tests/CI).
+# ---------------------------------------------------------------------------
+status_view() {
+  local cs root once
+  root="$(ai_repo_root)"
+  cs="$(ai_cs_file)"
+  once="${AI_DASH_ONCE:-0}"
+
+  while true; do
+    clear 2>/dev/null || printf '\033c'
